---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Desktop workspace pages: use the full window width (style guide: layout). */
  wide?: boolean;
}
const { title, description, wide = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/', label: 'Home' },
  { href: '/data', label: 'Data' },
  { href: '/gene', label: 'Gene lookup' },
  { href: '/drug', label: 'Drug effects' },
  { href: '/about', label: 'About' },
  { href: '/data-policy', label: 'Data policy' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preload" href="/fonts/source-serif-4-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/icons/cas9.svg" type="image/svg+xml" />
  </head>
  <body class={wide ? 'app' : undefined}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site">
      <div class="wrap">
        <a class="brand" href="/"><img class="icon" src="/icons/cas9.svg" alt="" width="44" height="44" />CRISPR Screen Explorer</a>
        <nav aria-label="Main">
          <ul>
            {nav.map((item) => (
              <li><a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        <p>An open project to put human CRISPR screen data in one standard, comparable format.</p>
        <ul>
          <li><a href="/data-policy">Data policy</a></li>
          <li><a href="/about">About</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>
