---
import Base from '../layouts/Base.astro';
import ScoreExplainer from '../components/ScoreExplainer.astro';
---
<Base wide title="Data overview · CRISPR Screen Explorer" description="What is in the BioGRID ORCS human CRISPR screen collection: screens, studies, methods and how comparable they are.">
  <h1>Data overview</h1>
  <p class="notice"><strong>Prototype.</strong> BioGRID ORCS 2.0.18, human screens, converted by this project's
    pipeline. Not yet reviewed by a bioinformatician; do not use for research.</p>
  <div id="overview" aria-live="polite"><p>Loading the data…</p></div>
  <h2>Screens</h2>
  <p>Narrow the list with the filters at the left; click a column header to sort, a row to see its details. Press / to search.</p>
  <ScoreExplainer />
  <div id="screens"><p>Loading the screens…</p></div>
  <p id="credit"></p>
</Base>

<script>
  import { getJSON, label, escapeHtml, type Screen, treatmentLabel } from '../scripts/data';
  import { mountTable } from '../scripts/table';
  import { draw, barTrace } from '../scripts/charts';
  import { loadLines, credit, type Line } from '../scripts/context';

  const box = document.getElementById('overview')!;
  async function main() {
  try {
    const [summary, screens, lines] = await Promise.all([getJSON<any>('summary.json'), getJSON<Screen[]>('screens.json'), loadLines()]);
    // Cell line context (DepMap + Cellosaurus) is optional: without it the table keeps its original columns.
    const lineOf = (s: Screen): Line | null => {
      const i = lines?.screen_line[String(s.screen_id)];
      return i === undefined ? null : lines!.lines[i];
    };
    const n = summary.screens;
    box.innerHTML = `
      <ul class="stats">
        <li><b>${n.toLocaleString('en')}</b><span>screens</span></li>
        <li><b>${summary.studies.toLocaleString('en')}</b><span>studies</span></li>
        <li><b>${(summary.rows / 1e6).toFixed(1)} M</b><span>gene results</span></li>
        <li><b>${(summary.by_status.anchored ?? 0).toLocaleString('en')}</b><span>on the essential-gene scale</span></li>
      </ul>
      <h2>The collection at a glance</h2>
      <p>Each screen's scores are aligned so that low means depleted, then turned into a within-screen rank.
        Screens that qualify also get a scale where 0 is a typical non-essential gene and −1 a typical core-essential gene.</p>
      <div class="chart-grid">
        <div class="card"><h3>How comparable are the screens?</h3><div class="chart" id="c-status" role="group" aria-label="Screens by comparability class"></div></div>
        <div class="card"><h3>Perturbation</h3><div class="chart" id="c-pert" role="group" aria-label="Screens by perturbation type"></div></div>
        <div class="card"><h3>Selection</h3><div class="chart" id="c-sel" role="group" aria-label="Screens by selection type"></div></div>
        <div class="card"><h3>Most screened cell lines</h3><div class="chart" id="c-cell" role="group" aria-label="Most screened cell lines"></div></div>
      </div>`;
    const drawBars = (id: string, counts: Record<string, number>) => draw(document.getElementById(id)!, [barTrace(counts)], { margin: { l: 130, r: 16, t: 8, b: 32 } }, { displayModeBar: false });
    drawBars('c-status', summary.by_status); drawBars('c-pert', summary.by_perturbation);
    drawBars('c-sel', summary.by_selection); drawBars('c-cell', summary.top_cell_lines);

    const text = (v: string | null | undefined) => escapeHtml(v ?? '–');
    if (lines) document.getElementById('credit')!.innerHTML = credit(lines);
    const detail = (s: Screen) => {
      const l = lineOf(s);
      const row = (k: string, v: string) => `<dt>${k}</dt><dd>${v}</dd>`;
      return `<h3>${text(s.author_label ?? s.study_id)}</h3><dl>
        ${row('Cell line', text(s.cell_line_label))}${row('Phenotype', text(s.phenotype))}${row('Treatment', text(treatmentLabel(s)))}
        ${row('Library', text(s.library_name))}${row('Perturbation', text(label(s.perturbation_type)))}${row('Selection', text(label(s.selection_type)))}
        ${row('Scoring method', text(s.scoring_method))}${row('Genes', (s.rows ?? 0).toLocaleString('en'))}
        ${row('Comparable as', text(label(s.normalization_status)))}${row('Score direction', text(s.direction))}
        ${l ? row('Tissue', text(l.lineage)) + row('Key mutations in line', l.drivers.length ? escapeHtml(l.drivers.join(', ')) : 'none in panel') : ''}</dl>`;
    };
    mountTable<Screen>(document.getElementById('screens')!, {
      detail, rows: screens, noun: 'screens', label: 'Screens table',
      caption: 'Table 1. Screens in the collection. Genes = number of gene results in the screen.',
      search: { label: lines ? 'Search study, cell line, phenotype, treatment or mutated gene' : 'Search study, cell line, phenotype or treatment', in: [(s) => s.author_label, (s) => s.study_id, (s) => s.cell_line_label, (s) => s.phenotype, (s) => s.treatment, (s) => lineOf(s)?.drivers.join(' ')] },
      facets: [
        { key: 'cell', label: 'Cell line', get: (s) => s.cell_line_label },
        { key: 'study', label: 'Study', get: (s) => s.author_label ?? s.study_id },
        { key: 'library', label: 'Library', get: (s) => s.library_name },
        { key: 'phenotype', label: 'Phenotype', get: (s) => s.phenotype },
        { key: 'setup', label: 'Setup', get: (s) => s.experimental_setup },
        { key: 'treatment', label: 'Treatment', get: (s) => s.treatment ?? 'none' },
        { key: 'type', label: 'Type', get: (s) => s.perturbation_type, show: label },
        { key: 'selection', label: 'Selection', get: (s) => s.selection_type, show: label },
        { key: 'status', label: 'Comparable as', get: (s) => s.normalization_status, show: label },
        ...(lines ? [{ key: 'tissue', label: 'Tissue', get: (s: Screen) => lineOf(s)?.lineage }] : []),
      ],
      columns: [
        { label: 'Study', cell: (s) => text(s.author_label ?? s.study_id), sort: (s) => s.author_label ?? s.study_id },
        { label: 'Year', cell: (s) => String(s.year ?? '–'), sort: (s) => s.year, num: true },
        { label: 'Cell line', cell: (s) => text(s.cell_line_label), sort: (s) => s.cell_line_label },
        { label: 'Library', cell: (s) => text(s.library_name), sort: (s) => s.library_name },
        { label: 'Type', cell: (s) => text(label(s.perturbation_type)), sort: (s) => s.perturbation_type },
        { label: 'Selection', cell: (s) => text(label(s.selection_type)), sort: (s) => s.selection_type },
        { label: 'Phenotype', cell: (s) => text(s.phenotype), sort: (s) => s.phenotype },
        { label: 'Treatment', cell: (s) => text(treatmentLabel(s)), sort: (s) => s.treatment },
        { label: 'Genes', cell: (s) => (s.rows ?? 0).toLocaleString('en'), sort: (s) => s.rows, num: true },
        { label: 'Comparable as', cell: (s) => text(label(s.normalization_status)), sort: (s) => s.normalization_status },
        ...(lines ? [
          { label: 'Tissue', cell: (s: Screen) => text(lineOf(s)?.lineage), sort: (s: Screen) => lineOf(s)?.lineage },
          { label: 'Key mutations in line', cell: (s: Screen) => {
            const l = lineOf(s);
            if (!l) return '–';
            const flag = l.problematic ? ' <small>line flagged by Cellosaurus (misidentified or contaminated)</small>' : '';
            return (l.drivers.length ? escapeHtml(l.drivers.join(', ')) : 'none in panel') + flag;
          }, sort: (s: Screen) => lineOf(s)?.drivers.length, num: true },
        ] : []),
      ],
    });
  } catch (err) {
    box.innerHTML = `<p class="notice"><strong>Data not available.</strong> ${escapeHtml(String(err))}</p>`;
  }
  }
  main();
</script>
