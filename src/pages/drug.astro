---
import Base from '../layouts/Base.astro';
---
<Base title="Drug effects · CRISPR Screen Explorer" description="Compare a CRISPR screen with a drug to a screen of the same cells without it.">
  <h1>Drug effects</h1>
  <p class="notice"><strong>Prototype.</strong> Not yet reviewed by a bioinformatician; do not use for research.</p>
  <p>Each dot is a gene. Across: its score in a screen of the cells <em>without</em> the drug. Up: its score in the screen
    <em>with</em> the drug. Genes on the diagonal behave the same either way. Lab analogy: two plates from the same
    cells, one with DMSO, one with drug, and each gene is plotted by how it did on each plate.</p>
  <div id="out" aria-live="polite"><p>Loading…</p></div>
</Base>

<script>
  import { getJSON, fmt, escapeHtml, treatmentLabel, type Screen } from '../scripts/data';
  import { joinVectors, topDifferences, drugsOf, MATCH_TEXT, type Vector, type Match, type Point } from '../scripts/drug';

  const out = document.getElementById('out')!;
  const opt = (v: string, t: string) => `<option value="${escapeHtml(v)}">${escapeHtml(t)}</option>`;
  const study = (s: Screen) => `${s.author_label ?? s.study_id} · ${s.cell_line_label} · ${s.library_name}`;

  async function main() {
    try {
      const [screens, pairs, perts] = await Promise.all([
        getJSON<Screen[]>('screens.json'), getJSON<Record<string, [string, Match][]>>('drug_pairs.json'),
        getJSON<string[]>('perts.json')]);
      const byId = new Map(screens.map((s) => [s.screen_id, s]));
      const drugs = drugsOf(screens).filter((d) => screens.some((s) => s.treatment === d && s.has_z && pairs[s.screen_id]?.some(([c]) => byId.get(c)?.has_z)));
      if (!drugs.length) { out.innerHTML = '<p>No drug screens with a usable no-drug screen are published yet.</p>'; return; }
      out.innerHTML = `
        <div class="lookup">
          <label>Drug<br /><select id="drug">${drugs.map((d) => opt(d, d)).join('')}</select></label>
          <label>Drug screen<br /><select id="screen"></select></label>
          <label>No-drug screen<br /><select id="control"></select></label>
          <label>Highlight gene<br /><input id="gene" autocomplete="off" placeholder="e.g. BRCA2" /></label>
        </div>
        <p id="match"></p>
        <canvas id="plot" width="640" height="640" role="img" aria-label="Scatter of gene scores without and with the drug" style="width:100%;max-width:640px;height:auto;border:1px solid var(--border);background:var(--surface)"></canvas>
        <p id="stats"></p>
        <p class="notice"><strong>Reading the scores.</strong> Scores are each screen's own score, as the paper reported it, converted to
          a within-screen robust z (distance from the median in units of the spread). They are not aligned so that low means depleted:
          in some screens a high score means enriched, in others it means depleted. The score used is named under the plot.
          Read it with the paper's definition, and trust the shape of the cloud more than single dots.</p>
        <div id="tops"></div>`;
      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      const cache = new Map<string, Promise<Vector>>();
      const vec = (id: string) => { if (!cache.has(id)) cache.set(id, getJSON<Vector>(`s/${id.replace(/\D/g, '').padStart(4, '0')}.json`)); return cache.get(id)!; };
      let points: Point[] = [];
      const query = () => $<HTMLInputElement>('gene').value.trim().toUpperCase();

      const fillScreens = () => {
        const ok = screens.filter((s) => s.treatment === $<HTMLSelectElement>('drug').value && s.has_z && pairs[s.screen_id]?.some(([c]) => byId.get(c)?.has_z));
        $('screen').innerHTML = ok.map((s) => opt(s.screen_id, `${study(s)} · ${treatmentLabel(s)}`)).join('');
        fillControls();
      };
      const fillControls = () => {
        const list = (pairs[$<HTMLSelectElement>('screen').value] ?? []).filter(([c]) => byId.get(c)?.has_z);
        $('control').innerHTML = list.map(([c, m]) => opt(c, `${study(byId.get(c)!)} (${MATCH_TEXT[m].split(' (')[0]})`)).join('');
        draw();
      };

      function paint() {
        const cv = $<HTMLCanvasElement>('plot'), g = cv.getContext('2d')!, W = cv.width, pad = 40;
        const css = getComputedStyle(document.documentElement);
        const col = (n: string) => css.getPropertyValue(n).trim() || '#000';
        g.clearRect(0, 0, W, W);
        const lim = Math.max(3, ...points.map((p) => Math.max(Math.abs(p[0]), Math.abs(p[1])))) * 1.05;
        const px = (v: number) => pad + ((v + lim) / (2 * lim)) * (W - 2 * pad), py = (v: number) => W - px(v);
        g.strokeStyle = col('--border'); g.lineWidth = 1;
        g.beginPath(); g.moveTo(px(-lim), py(0)); g.lineTo(px(lim), py(0)); g.moveTo(px(0), py(-lim)); g.lineTo(px(0), py(lim)); g.stroke();
        g.setLineDash([6, 4]); g.beginPath(); g.moveTo(px(-lim), py(-lim)); g.lineTo(px(lim), py(lim)); g.stroke(); g.setLineDash([]);
        g.fillStyle = col('--chart-1'); g.globalAlpha = 0.25;
        for (const [x, y] of points) g.fillRect(px(x) - 1, py(y) - 1, 2, 2);
        g.globalAlpha = 1; g.fillStyle = col('--muted'); g.font = '14px serif';
        g.fillText('no-drug score →', pad, W - 8); g.save(); g.translate(14, W - pad); g.rotate(-Math.PI / 2); g.fillText('drug score →', 0, 0); g.restore();
        const q = $<HTMLInputElement>('gene').value.trim().toUpperCase();
        const hit = q ? points.find((p) => perts[p[2]]?.toUpperCase() === q) : undefined;
        if (hit) {
          g.fillStyle = col('--chart-4'); g.beginPath(); g.arc(px(hit[0]), py(hit[1]), 6, 0, 2 * Math.PI); g.fill();
          g.fillStyle = col('--text'); g.fillText(perts[hit[2]], px(hit[0]) + 9, py(hit[1]) - 6);
        }
        $('gene').setAttribute('aria-describedby', 'stats');
        $('stats').dataset.found = hit ? '1' : q ? '0' : '';
      }

      async function draw() {
        const sid = $<HTMLSelectElement>('screen').value, cid = $<HTMLSelectElement>('control').value;
        if (!sid || !cid) { points = []; $('tops').innerHTML = ''; return; }
        const [d, c] = await Promise.all([vec(sid), vec(cid)]);
        points = joinVectors(c, d);
        const ds = byId.get(sid)!, cs = byId.get(cid)!, m = pairs[sid].find(([x]) => x === cid)![1];
        $('match').innerHTML = `<strong>Match:</strong> ${escapeHtml(MATCH_TEXT[m])}.`;
        $('stats').textContent = `${points.length.toLocaleString('en')} genes in both screens. Drug score: ${ds.primary_score_name ?? 'primary score'}. ` +
          `No-drug score: ${cs.primary_score_name ?? 'primary score'}.` + (query() && !points.some((p) => perts[p[2]]?.toUpperCase() === query()) ? ' Gene not in both screens.' : '');
        const rows = (p: Point[]) => p.map((r) => `<tr><td class="gene">${escapeHtml(perts[r[2]])}</td><td>${fmt(r[0])}</td><td>${fmt(r[1])}</td><td>${fmt(r[1] - r[0])}</td></tr>`).join('');
        const table = (title: string, p: Point[]) => `<h3>${title}</h3><div class="table-box" tabindex="0" role="region" aria-label="${title}"><table><thead><tr><th>Gene</th><th>No drug</th><th>Drug</th><th>Difference</th></tr></thead><tbody>${rows(p)}</tbody></table></div>`;
        $('tops').innerHTML = table('Lowest drug score relative to no drug', topDifferences(points, -1)) + table('Highest drug score relative to no drug', topDifferences(points, 1));
        paint();
      }

      $('drug').addEventListener('change', fillScreens);
      $('screen').addEventListener('change', fillControls);
      $('control').addEventListener('change', draw);
      $('gene').addEventListener('input', () => { paint(); const q = $<HTMLInputElement>('gene').value.trim().toUpperCase(); $('stats').dataset.found = q && points.some((p) => perts[p[2]]?.toUpperCase() === q) ? '1' : q ? '0' : ''; });
      fillScreens();
    } catch (err) {
      out.innerHTML = `<p class="notice"><strong>Data not available.</strong> ${escapeHtml(String(err))}</p>`;
    }
  }
  main();
</script>
