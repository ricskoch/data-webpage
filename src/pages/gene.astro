---
import Base from '../layouts/Base.astro';
import ScoreExplainer from '../components/ScoreExplainer.astro';
---
<Base wide title="Gene explorer · CRISPR Screen Explorer" description="Explore one gene across all human CRISPR screens in BioGRID ORCS, grouped by tissue, cell line or treatment, with each screen's context.">
  <h1>Gene explorer</h1>
  <p class="notice"><strong>Prototype.</strong> Scores are aligned so that low means depleted. Not yet reviewed
    by a bioinformatician; do not use for research.</p>
  <div class="page-side">
    <div class="side" role="group" aria-label="Controls">
      <div class="panel">
        <h2>Gene</h2>
        <form id="form" class="lookup">
          <label>Gene symbol<input id="q" name="g" autocomplete="off" placeholder="e.g. TP53" required /></label>
          <button type="submit">Look up</button>
          <p id="form-error" class="error" role="alert" hidden></p>
        </form>
      </div>
      <div id="pathway-box" class="panel" hidden>
        <h2>Browse by pathway</h2>
        <p class="caption">Pick a Reactome pathway to see its genes and to limit the gene dropdown to them.</p>
        <div class="lookup">
          <label>Pathway<input id="pw" autocomplete="off" placeholder="e.g. Apoptosis" /></label>
          <button type="button" id="pw-clear" hidden>Clear pathway</button>
        </div>
        <div id="pw-out" aria-live="polite"></div>
        <p id="pw-credit"></p>
      </div>
      <div class="panel">
        <h2>Filter the screens</h2>
        <div id="filters"><p class="caption">Filters appear once a gene is loaded.</p></div>
      </div>
    </div>
    <div class="main-pane">
      <ScoreExplainer />
      <div id="out" aria-live="polite"></div>
    </div>
  </div>
</Base>

<script>
  import { getJSON, fmt, label, escapeHtml, type Screen, type GeneRow, treatmentLabel } from '../scripts/data';
  import { mountTable } from '../scripts/table';
  import { makeGrouping, KIND_LABELS, NEEDS_GENE, type GroupKind } from '../scripts/grouping';
  import { drugSummary } from '../scripts/drug';
  import { mountCombobox, suggest, exactSymbol } from '../scripts/combobox';
  import { draw, palette } from '../scripts/charts';
  import { groupForChart } from '../scripts/explorer';
  import { loadPathways, pathwaysOfGene, genesInCollection, type Pathways, type Pathway } from '../scripts/pathways';
  import { dependencyByMutation, verdict, median as workflowMedian, MIN_LINES, type Comparison } from '../scripts/workflow';
  import { loadLines, loadGene, credit, geneInLine, copyLabel, expressionLabel, type Lines, type LineGene } from '../scripts/context';

  const out = document.getElementById('out')!;
  const input = document.getElementById('q') as HTMLInputElement;
  let genes: Record<string, [string, number]> | null = null;
  let screens: Screen[] | null = null;
  let lines: Lines | null | undefined;

  /** One row of the plot: where the gene ranks in one screen (0 most depleted, 1 most enriched) and how to group it. */
  type Item = { id: number; rank: number | null; group: string | null; tip: string };
  let pick: (id: number) => void = () => {};

  const boxTrace = (name: string, xs: (number | null)[], color: string, extra: Record<string, unknown> = {}) => ({
    type: 'box', orientation: 'h', name, x: xs, y: xs.map(() => name), boxpoints: 'all', jitter: 0.6, pointpos: 0,
    fillcolor: 'rgba(0,0,0,0)', line: { color, width: 1.5 }, marker: { color, size: 6, opacity: 0.65 }, ...extra,
  });

  /** Box and jittered dots per group, one dot per screen; the picked screen gets a ring. Clicking a dot picks its table row. */
  async function drawStrip(el: HTMLElement, items: Item[], picked: number | null) {
    const p = palette();
    const groups = groupForChart(items.filter((i) => i.rank !== null), (i) => i.group, (i) => i.rank);
    const traces: any[] = groups.map((g, k) => boxTrace(g.label, g.items.map((i) => i.rank), p.series[k % p.series.length],
      { customdata: g.items.map((i) => i.id), text: g.items.map((i) => i.tip), hoverinfo: 'text' }));
    const sel = items.find((i) => i.id === picked && i.rank !== null);
    const home = sel && groups.find((g) => g.items.includes(sel));
    if (sel && home) traces.push({ type: 'scatter', mode: 'markers', name: 'selected', x: [sel.rank], y: [home.label], hoverinfo: 'skip',
      marker: { size: 14, color: 'rgba(0,0,0,0)', line: { color: p.text, width: 2.5 } } });
    await draw(el, traces, { height: 110 + 34 * Math.max(groups.length, 1), margin: { l: 150, r: 16, t: 8, b: 44 },
      xaxis: { title: { text: 'Rank within the screen: 0 most depleted, 1 most enriched' }, range: [-0.02, 1.02] },
      yaxis: { type: 'category', autorange: 'reversed', categoryorder: 'array', categoryarray: groups.map((g) => g.label) } });
    const gd = el as any;
    gd.removeAllListeners?.('plotly_click');
    gd.on('plotly_click', (ev: any) => { const id = ev.points?.[0]?.customdata; if (typeof id === 'number') pick(id); });
  }

  const median = (v: number[]) => { const s = [...v].sort((a, b) => a - b); const m = s.length >> 1;
    return s.length ? (s.length % 2 ? s[m] : (s[m - 1] + s[m]) / 2) : null; };

  const findGene = (symbol: string) => Object.keys(genes!).find((k) => k.toUpperCase() === symbol.toUpperCase());
  const pFmt = (p: number | null) => (p === null || Number.isNaN(p) ? '–' : p < 0.001 ? p.toExponential(1) : p.toFixed(3));

  /** Per-line values of the two groups on the essential scale (-1 core-essential, 0 non-essential). */
  function drawGroups(el: HTMLElement, c: Comparison, names: { a: string; b: string }) {
    const p = palette();
    return draw(el, [boxTrace(names.a, c.mutant.map((v) => v.value), p.series[0]), boxTrace(names.b, c.wildtype.map((v) => v.value), p.series[1])],
      { height: 230, margin: { l: 150, r: 16, t: 8, b: 44 },
        xaxis: { title: { text: 'Essential scale: −1 like a core-essential gene, 0 like a non-essential gene' } },
        yaxis: { type: 'category', autorange: 'reversed' } });
  }

  async function compare(x: string, rows: GeneRow[], kind: GroupKind, ySymbol: string, tissue: string) {
    const box = document.getElementById('workflow-out')!;
    let y = '', yctx: Awaited<ReturnType<typeof loadGene>>;
    if (NEEDS_GENE.includes(kind)) {
      const found = findGene(ySymbol);
      if (!found) { box.innerHTML = `<p>No gene <span class="gene">${escapeHtml(ySymbol)}</span> in this collection.</p>`; return; }
      y = found;
      yctx = await loadGene(...genes![y]);
      if (!yctx) { box.innerHTML = `<p>No cell line data for <span class="gene">${escapeHtml(y)}</span>.</p>`; return; }
    }
    const perScreen = rows.flatMap((r) => {
      const li = lines!.screen_line[String(screens![r[0]].screen_id)];
      return li === undefined || r[2] === null ? [] : [{ line: li, value: r[2] }];
    });
    const g = makeGrouping(kind, lines!, y, yctx, tissue);
    const c = dependencyByMutation(perScreen, g.group, g.include);
    const X = `<span class="gene">${escapeHtml(x)}</span>`;
    const med = (vs: { value: number }[]) => fmt(workflowMedian(vs.map((v) => v.value)));
    box.innerHTML = `<p><strong>${escapeHtml(verdict(c, x, y, g))}</strong></p>
      <ul>
        <li>${escapeHtml(g.a)} lines: ${c.mutant.length}; ${escapeHtml(g.b)} lines: ${c.wildtype.length} (at least ${MIN_LINES} each needed).</li>
        ${c.testable ? `<li>Median ${X} scale: ${med(c.mutant)} in ${escapeHtml(g.a)} vs ${med(c.wildtype)} in ${escapeHtml(g.b)} lines.
          Difference ${fmt(c.diff)} (95% interval ${fmt(c.ci![0])} to ${fmt(c.ci![1])}), Mann-Whitney p = ${pFmt(c.p)}.</li>` : ''}
      </ul>
      ${c.mutant.length + c.wildtype.length ? `<figure><div id="group-plot" class="chart" role="group" aria-label="Per-line values: ${c.mutant.length} ${escapeHtml(g.a)} and ${c.wildtype.length} ${escapeHtml(g.b)} lines"></div><figcaption>Fig. 2. One dot per cell line: the median of its screens on the essential scale for ${X}.</figcaption></figure>` : ''}
      <p><small>How to read this: one value per cell line, so a line screened often counts once. This answers one question;
        it is not corrected for testing many genes. Tissues are mixed, so tissue can explain a difference. Many screens come
        from DepMap's own studies, which also produced the omics data. Lines in neither group, and lines flagged as misidentified
        or contaminated, are left out.${kind === 'mutation' && lines!.lines.some((l) => l.mutation_calls === undefined)
          ? ' This data release does not say which lines lack mutation calls; such lines count as wild-type.' : ''}</small></p>`;
    const gp = document.getElementById('group-plot');
    if (gp) await drawGroups(gp, c, g);
  }

  async function lookup(symbol: string) {
    out.innerHTML = '<p>Loading…</p>';
    try {
      genes ??= await getJSON<Record<string, [string, number]>>('genes.json');
      screens ??= await getJSON<Screen[]>('screens.json');
      const key = findGene(symbol);
      if (!key) {
        const near = suggest(Object.keys(genes), symbol, 5);
        out.innerHTML = `<p>No gene <span class="gene">${escapeHtml(symbol)}</span> in this collection. Symbols follow the source files; try an older name if it was renamed.${near.length ? ` Similar symbols: ${near.map((n) => `<a href="?g=${encodeURIComponent(n)}" class="gene">${escapeHtml(n)}</a>`).join(', ')}.` : ''}</p>`;
        return;
      }
      const [pid, shard] = genes![key];
      lines ??= await loadLines();
      const gctx = lines ? await loadGene(pid, shard) : undefined;
      const mutatedIn = gctx ? new Set(gctx.m.map((m) => m[0])).size : 0;
      const rows: GeneRow[] = (await getJSON<Record<string, GeneRow[]>>(`g/${String(shard).padStart(4, '0')}.json`))[pid] ?? [];
      const ranked = rows.filter((r) => r[1] !== null).sort((a, b) => a[1]! - b[1]!);
      const scaled = rows.map((r) => r[2]).filter((v): v is number => v !== null);
      const hits = rows.filter((r) => r[4] === 1).length;
      history.replaceState(null, '', `?g=${encodeURIComponent(key)}`);
      const ctxOn = !!(lines && gctx);
      out.innerHTML = `
        <h2><span class="gene">${escapeHtml(key)}</span></h2>
        <ul class="stats">
          <li><b>${rows.length}</b><span>screen results</span></li>
          <li><b>${ranked.length}</b><span>comparable by rank</span></li>
          <li><b>${fmt(median(ranked.map((r) => r[1]!)))}</b><span>median rank</span></li>
          <li><b>${fmt(median(scaled))}</b><span>median essential scale (${scaled.length})</span></li>
          <li><b>${hits}</b><span>hits called by the source</span></li>
          ${lines && gctx ? `<li><b>${mutatedIn}</b><span>of ${lines.lines.length} profiled lines carry a protein-altering mutation</span></li>` : ''}
        </ul>
        <div class="lookup"><label>Group the plot by<select id="group-by">${ctxOn ? '<option value="tissue">Tissue</option>' : ''}<option value="cell">Cell line</option><option value="treatment">Treatment</option><option value="phenotype">Phenotype</option></select></label></div>
        <figure><div id="strip" class="chart" role="group" aria-label="Rank of ${escapeHtml(key)} in each comparable screen, grouped. The results table below holds the same data."></div>
          <figcaption>Fig. 1. Rank of <span class="gene">${escapeHtml(key)}</span> within each comparable screen, one dot per screen. A gene that is essential everywhere sits at the left. The plot follows the filters; hover a dot for its screen, click to select its row.</figcaption></figure>
        ${lines ? `<h3>Biological workflow: where does this gene matter?</h3>
        <form id="workflow" class="lookup">
          <label>Compare lines by<br /><select id="by">${(Object.keys(KIND_LABELS) as GroupKind[]).map((k) => `<option value="${k}">${KIND_LABELS[k]}</option>`).join('')}</select></label>
          <label id="y-wrap">Gene<br /><input id="y" autocomplete="off" placeholder="e.g. KRAS" /></label>
          <label id="t-wrap" hidden>Tissue<br /><select id="tissue">${[...new Set(lines.lines.map((l) => l.lineage).filter(Boolean))].sort().map((t) => `<option>${escapeHtml(t!)}</option>`).join('')}</select></label>
          <button type="submit">Compare</button></form>
        <p class="examples">Textbook examples to try: ${EXAMPLES.map(([x, by, y, what]) => `<a href="?g=${x}&amp;by=${by}&amp;y=${y}" title="${what}">${x} by ${y} ${by === 'gain' ? 'gain' : by === 'copy' ? 'loss' : by === 'expression' ? 'off' : 'mutation'}</a>`).join(', ')}.</p>
        <div id="workflow-out" aria-live="polite"></div>` : ''}
        <div id="drugs"></div>
        <h3>Every screen result for this gene</h3>
        <div id="results"></div>${lines && gctx ? `<p>${credit(lines)}</p>` : ''}`;
      type Row = { id: number; s: Screen; rank: number | null; scale: number | null; z: number | null; hit: number; native: number | null;
        tissue: string | null; ctx: LineGene | null };
      const data: Row[] = rows.map((r, id) => {
        const s = screens![r[0]], li = lines?.screen_line[String(s.screen_id)];
        const line = li === undefined ? null : lines!.lines[li];
        return { id, s, rank: r[1], scale: r[2], z: r[3], hit: r[4], native: r[5], tissue: line?.lineage ?? null,
          ctx: li === undefined ? null : geneInLine(gctx, li) };
      });
      const dsum = drugSummary(data.map((r) => ({ treatment: r.s.treatment, cell_line_label: r.s.cell_line_label, hit: r.hit })));
      if (dsum.length) document.getElementById('drugs')!.innerHTML = `<h3>Response to drugs</h3>
        <p>Screens with a drug or other treatment that report <span class="gene">${escapeHtml(key)}</span>. A hit is the source's own call,
          so it can mean sensitising or protecting depending on the paper. Open a drug to compare its screens with untreated ones.</p>
        <div class="table-box" tabindex="0" role="region" aria-label="Drug screens for ${escapeHtml(key)}"><table><thead><tr><th>Treatment</th><th>Screens</th><th>Cell lines</th><th>Hits</th></tr></thead><tbody>${
          dsum.map((d) => `<tr><td><a href="/drug?d=${encodeURIComponent(d.drug)}">${escapeHtml(d.drug)}</a></td><td>${d.screens}</td><td>${d.lines}</td><td>${d.hits}</td></tr>`).join('')}</tbody></table></div>`;
      const ctxCols = lines && gctx;
      const text = (v: string | null | undefined) => escapeHtml(v ?? '–');
      const inGene = pw ? pathwaysOfGene(pw, key) : [];
      if (inGene.length) out.querySelector('.stats')!.insertAdjacentHTML('afterend',
        `<p>Reactome pathways with <span class="gene">${escapeHtml(key)}</span>, most specific first: ${inGene.map((p) =>
          `<button type="button" class="chip" data-pw="${escapeHtml(p.name)}">${escapeHtml(p.name)}</button>`).join(' ')}</p>`);
      const stripBox = document.getElementById('strip')!;
      const groupBy = document.getElementById('group-by') as HTMLSelectElement;
      let shown: Row[] = [], shownPick: Row | null = null;
      const groupOf = (r: Row) => ({ tissue: r.tissue, cell: r.s.cell_line_label, treatment: r.s.treatment ?? 'none', phenotype: r.s.phenotype })[groupBy.value as 'tissue'];
      const redraw = () => drawStrip(stripBox, shown.map((r) => ({ id: r.id, rank: r.rank, group: groupOf(r),
        tip: `${r.s.author_label ?? r.s.study_id}, ${r.s.cell_line_label}: rank ${fmt(r.rank)}` })), shownPick?.id ?? null);
      const detail = (r: Row) => {
        const row = (k: string, v: string) => `<dt>${k}</dt><dd>${v}</dd>`;
        return `<h3>${text(r.s.author_label ?? r.s.study_id)}</h3><dl>
          ${row('Cell line', text(r.s.cell_line_label))}${row('Phenotype', text(r.s.phenotype))}${row('Treatment', text(treatmentLabel(r.s)))}
          ${row('Rank', fmt(r.rank))}${row('Scale', fmt(r.scale))}${row('Robust z', fmt(r.z))}${row('Hit', r.hit ? 'yes' : 'no')}
          ${row('Native score', `${fmt(r.native, 3)} ${text(r.s.scoring_method)}`)}${row('Comparable as', text(label(r.s.normalization_status)))}
          ${r.tissue ? row('Tissue', text(r.tissue)) : ''}${r.ctx ? row('Mutation in line', text(r.ctx.mutation ?? 'none')) : ''}</dl>`;
      };
      const handle = mountTable<Row>(document.getElementById('results')!, {
        detail,
        filtersIn: document.getElementById('filters')!,
        onView: (view, picked) => { shown = view; shownPick = picked; redraw().catch((err) => { stripBox.textContent = `Could not draw the plot: ${err}`; }); },
        rows: data, noun: 'screen results', label: 'Results table', sort: { column: 5, dir: 'asc' },
        caption: 'Table 1. Results for this gene, most depleted first. Rank: 0 to 1. Scale: 0 = like a non-essential gene, −1 = like a core-essential gene.',
        search: { label: 'Search study, cell line or treatment', in: [(r) => r.s.author_label, (r) => r.s.study_id, (r) => r.s.cell_line_label, (r) => r.s.treatment] },
        facets: [
          { key: 'cell', label: 'Cell line', get: (r) => r.s.cell_line_label },
          { key: 'phenotype', label: 'Phenotype', get: (r) => r.s.phenotype },
          { key: 'treatment', label: 'Treatment', get: (r) => r.s.treatment ?? 'none' },
          { key: 'selection', label: 'Selection', get: (r) => r.s.selection_type, show: label },
          { key: 'status', label: 'Comparable as', get: (r) => r.s.normalization_status, show: label },
          { key: 'hit', label: 'Hit', get: (r) => (r.hit ? 'yes' : 'no') },
          ...(ctxCols ? [
            { key: 'tissue', label: 'Tissue', get: (r: Row) => r.tissue },
            { key: 'mut', label: `${key} mutated in line`, get: (r: Row) => (r.ctx ? (r.ctx.mutation ? 'yes' : 'no') : null) },
            { key: 'expr', label: `${key} expression`, get: (r: Row) => expressionLabel(r.ctx?.expression ?? null) },
            { key: 'cn', label: `${key} copy number`, get: (r: Row) => copyLabel(r.ctx?.copyNumber ?? null) },
          ] : []),
        ],
        columns: [
          { label: 'Study', cell: (r) => text(r.s.author_label ?? r.s.study_id), sort: (r) => r.s.author_label ?? r.s.study_id },
          { label: 'Cell line', cell: (r) => text(r.s.cell_line_label), sort: (r) => r.s.cell_line_label },
          { label: 'Phenotype', cell: (r) => text(r.s.phenotype), sort: (r) => r.s.phenotype },
          { label: 'Treatment', cell: (r) => text(treatmentLabel(r.s)), sort: (r) => r.s.treatment },
          { label: 'Selection', cell: (r) => text(label(r.s.selection_type)), sort: (r) => r.s.selection_type },
          { label: 'Rank', cell: (r) => fmt(r.rank), sort: (r) => r.rank, num: true },
          { label: 'Scale', cell: (r) => fmt(r.scale), sort: (r) => r.scale, num: true },
          { label: 'Robust z', cell: (r) => fmt(r.z), sort: (r) => r.z, num: true },
          { label: 'Hit', cell: (r) => (r.hit ? 'yes' : 'no'), sort: (r) => r.hit },
          { label: 'Native score', cell: (r) => `${fmt(r.native, 3)} <small>${text(r.s.scoring_method)}</small>`, sort: (r) => r.native, num: true },
          ...(ctxCols ? [
            { label: 'Tissue', cell: (r: Row) => text(r.tissue), sort: (r: Row) => r.tissue },
            { label: 'Mutation in line', cell: (r: Row) => text(r.ctx?.mutation ?? (r.ctx ? 'none' : null)), sort: (r: Row) => r.ctx?.mutation },
            { label: 'Expression', cell: (r: Row) => r.ctx?.expression == null ? '–' : `${fmt(r.ctx.expression, 1)} <small>${expressionLabel(r.ctx.expression)}</small>`, sort: (r: Row) => r.ctx?.expression, num: true },
            { label: 'Copy number', cell: (r: Row) => r.ctx?.copyNumber == null ? '–' : `${fmt(r.ctx.copyNumber, 2)} <small>${copyLabel(r.ctx.copyNumber)}</small>`, sort: (r: Row) => r.ctx?.copyNumber, num: true },
          ] : []),
        ],
      });
      const by = document.getElementById('by') as HTMLSelectElement | null;
      const syncForm = () => {
        const kind = by!.value as GroupKind;
        document.getElementById('y-wrap')!.hidden = !NEEDS_GENE.includes(kind);
        document.getElementById('t-wrap')!.hidden = kind !== 'tissue';
      };
      by?.addEventListener('change', syncForm);
      pick = (id) => handle.select(data[id]);
      groupBy.addEventListener('change', () => { redraw(); });
      const y = document.getElementById('y') as HTMLInputElement | null;
      if (y) mountCombobox(y, () => Object.keys(genes!), () => {});
      document.getElementById('workflow')?.addEventListener('submit', (e) => {
        e.preventDefault();
        syncForm();
        const kind = by!.value as GroupKind, y = (document.getElementById('y') as HTMLInputElement).value.trim();
        const tissue = (document.getElementById('tissue') as HTMLSelectElement).value;
        if (NEEDS_GENE.includes(kind) && !y) { document.getElementById('workflow-out')!.textContent = 'Enter a gene symbol.'; return; }
        compare(key, rows, kind, y, tissue).catch((err) => { document.getElementById('workflow-out')!.textContent = `Could not compare: ${err}`; });
      });
    } catch (err) {
      out.innerHTML = `<p class="notice"><strong>Data not available.</strong> ${escapeHtml(String(err))}</p>`;
    }
  }

  // Textbook questions: gene X knocked out, lines split by the state of gene Y (also reachable by link, ?g=X&by=...&y=Y).
  const EXAMPLES: [string, GroupKind, string, string][] = [
    ['ERBB2', 'gain', 'ERBB2', 'Copy-number artefact check: lines with extra ERBB2 copies should need ERBB2'],
    ['SMARCA2', 'expression', 'SMARCA4', 'Paralog pair: SMARCA2 is needed when SMARCA4 is switched off'],
    ['ARID1B', 'mutation', 'ARID1A', 'Paralog pair: ARID1B is needed when ARID1A is mutated'],
    ['PRMT5', 'copy', 'MTAP', 'PRMT5 is needed when MTAP is lost (MTAP sits next to the tumour suppressor CDKN2A)'],
  ];
  function runExample(p: URLSearchParams) {
    const by = p.get('by') as GroupKind | null, y = p.get('y');
    const sel = document.getElementById('by') as HTMLSelectElement | null;
    if (!sel || !by || !(by in KIND_LABELS)) return;
    sel.value = by;
    (document.getElementById('y') as HTMLInputElement).value = y ?? '';
    (document.getElementById('workflow') as HTMLFormElement).requestSubmit();
  }

  // Gene symbols load up front so the dropdown and the validation below work before the first lookup.
  const known = () => (genes ? Object.keys(genes) : []);
  const formError = document.getElementById('form-error')!;
  const go = (symbol: string) => {
    formError.hidden = true;
    if (genes && !exactSymbol(known(), symbol)) {
      const near = suggest(known(), symbol, 5);
      formError.textContent = `"${symbol}" is not a gene in this collection.${near.length ? ` Did you mean ${near.join(', ')}?` : ' Start typing and pick a symbol from the list.'}`;
      formError.hidden = false;
      return;
    }
    lookup(symbol);
  };
  // Pathways (optional): picking one limits the gene dropdown to its genes; typing any other known symbol still works.
  let pw: Pathways | null = null, scope: Pathway | null = null;
  const pwInput = document.getElementById('pw') as HTMLInputElement;
  const pwOut = document.getElementById('pw-out')!, pwClear = document.getElementById('pw-clear')!;
  function choosePathway(name: string) {
    scope = pw?.pathways.find((p) => p.name === name) ?? null;
    pwClear.hidden = !scope;
    if (!scope) { pwOut.innerHTML = ''; return; }
    const inScreens = genesInCollection(scope, known());
    pwInput.value = scope.name;
    pwOut.innerHTML = `<p>${inScreens.length} of ${scope.genes.length} genes of this pathway are in the screens; the gene box now suggests only these.
      Click one to look it up.</p><p>${inScreens.map((g) => `<button type="button" class="chip gene" data-gene="${escapeHtml(g)}">${escapeHtml(g)}</button>`).join(' ')}</p>`;
  }
  mountCombobox(input, () => (scope ? genesInCollection(scope, known()) : known()), go);
  mountCombobox(pwInput, () => pw?.pathways.map((p) => p.name) ?? [], choosePathway);
  pwClear.addEventListener('click', () => { pwInput.value = ''; choosePathway(''); });
  document.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-gene], [data-pw]');
    if (b?.dataset.gene) { input.value = b.dataset.gene; go(b.dataset.gene); }
    else if (b?.dataset.pw) { choosePathway(b.dataset.pw); document.getElementById('pathway-box')!.scrollIntoView({ block: 'nearest' }); }
  });
  loadPathways().then((p) => {
    if (!p) return;
    pw = p;
    document.getElementById('pathway-box')!.hidden = false;
    document.getElementById('pw-credit')!.innerHTML = `<small>Pathway data: <a href="https://reactome.org">Reactome</a> release ${escapeHtml(p.release)}, <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.</small>`;
  });
  getJSON<Record<string, [string, number]>>('genes.json').then((g) => { genes ??= g; }).catch(() => { /* lookup() reports the load error */ });
  document.getElementById('form')!.addEventListener('submit', (e) => { e.preventDefault(); go(input.value.trim()); });
  const params = new URLSearchParams(location.search);
  const start = params.get('g');
  if (start) { input.value = start; lookup(start).then(() => runExample(params)); }
</script>
