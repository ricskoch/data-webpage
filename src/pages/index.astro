---
import Base from '../layouts/Base.astro';

const cards = [
  { href: '/data', title: 'Screen browser', text: 'Filter all screens by cell line, library, treatment and tissue.' },
  { href: '/gene', title: 'Gene explorer', text: 'One gene across every screen, with cell line context and pathways.' },
  { href: '/associations', title: 'Associations', text: 'Precomputed: which genes matter more in a tissue or with a driver mutation.' },
  { href: '/drug', title: 'Drug effects', text: 'Compare a screen with a drug to the same cells without it.' },
  { href: '/data-policy', title: 'Data and licences', text: 'Where the data comes from, how it is licensed and cited.' },
];
---
<Base
  title="CRISPR Screen Explorer (working title)"
  description="Browse and compare public human CRISPR screens in one standard format, with experiment details alongside the results."
>
  <section class="hero">
    <h1>Explore human CRISPR screens without writing code</h1>
    <p class="lede">
      Public CRISPR screen results are spread over many files and formats. This project puts them
      in one standard format so you can browse screens, look up a gene, and check whether similar
      experiments agree, with the experimental details shown next to every result.
    </p>
  </section>
  <p class="notice">
    <strong>Work in progress.</strong> The first data source is BioGRID ORCS (human screens).
    Nothing here is ready for research use yet.
  </p>
  <ul class="cards">
    {cards.map((c) => (
      <li><h3><a href={c.href}>{c.title}</a></h3><p>{c.text}</p></li>
    ))}
  </ul>
  <p><a href="/about">Read more about the project</a></p>
</Base>
